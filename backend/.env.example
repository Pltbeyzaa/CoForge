DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CORS (frontend adreslerini virgülle ayır)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://127.0.0.1:5500,http://localhost:5500

MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_DB=coforge
MYSQL_USER=coforge
MYSQL_PASSWORD=coforge_password

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Embedding konfig (NLP hafta 5)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIM=1536

# Milvus collection name (istege bagli)
MILVUS_PROJECT_COLLECTION=project_post_embeddings
MILVUS_USER_COLLECTION=user_profile_embeddings

# Django'u bilgisayarda (Docker disinda) calistiriyorsan: Milvus portu infra/docker-compose ile 127.0.0.1:19530 yayinlanir.
# "localhost" bazi Windows kurulumlarinda ::1 (IPv6) cozumler ve pymilvus baglanamaz; 127.0.0.1 kullanin.
# Django'yu docker compose icindeki bir serviste calistiriyorsan: MILVUS_HOST=milvus ve ayni compose agina baglayin.
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530

# Eslesme listesi esigi (yuzde). 0 = filtre yok. Prod icin 40-70.
COFORGE_MATCH_THRESHOLD_PERCENT=0
# Ilan sahibi aday onerisi: Milvus upsert edilecek max kullanici sayisi
COFORGE_RECRUITMENT_UPSERT_CAP=2000

